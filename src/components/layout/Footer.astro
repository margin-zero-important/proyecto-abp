---
import Icon from '@/components/icons/icon.astro';
---

<footer
  class="max-w-5xl w-full mx-auto flex items-center justify-center gap-2 pt-12 pb-5"
>
  <p
    class="flex gap-1 my-auto text-sm text-custom-gray-600 dark:text-custom-gray-300"
  >
    © 2026 Made by
    <a
      class="relative inline-block after:[content:''] after:block after:h-0.5 after:bg-custom-gray-300 after:scale-x-0 after:transition-transform after:duration-300 hover:after:scale-x-100 after:origin-left group"
      href="https://github.com/margin-zero-important"
      target="_blank"
      rel="noopener noreferrer"
      ><span
        class="flex items-center justify-center group-hover:text-custom-gray-600 group-hover:dark:text-custom-gray-300"
        >Marisol Henao <Icon
          name="arrowRight"
          class="size-4 -rotate-45 text-transparent group-hover:text-custom-gray-600 group-hover:dark:text-custom-gray-300"
        /></span
      >
    </a>
  </p>
</footer>
